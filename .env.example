# Version de l'image du calendrier (à incrémenter à chaque livraison)
APP_VERSION=1.0.0
NODE_VERSION=24.18.1-alpine3.24
TRAEFIK_VERSION=v3.7.19
CLOUDFLARED_VERSION=2026.11.1

PIOK_DOMAIN=piok.domain.com
CLOUDFLARE_TUNNEL_TOKEN=

# Mot de passe de la page /admin (identifiant libre). Vide = page désactivée.
ADMIN_PASSWORD=
# true = toutes les cases ouvertes (dev uniquement, JAMAIS en prod)
UNLOCK_ALL=false
# Année du calendrier (par défaut : l'année en cours)
CALENDAR_YEAR=2026
